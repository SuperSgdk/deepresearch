# Configuration template only. Real keys, private endpoints and account values
# belong in the ignored local .env; never add them to this tracked file.
# Required for model inference and embeddings.
DASHSCOPE_API_KEY=
# Required for the research branch's web search.
BOCHA_API_KEY=
MODEL=qwen-plus
MAX_ITERATIONS=1
ENABLE_MEMORY=true
SHORT_TERM_BACKEND=postgres
LONG_TERM_BACKEND=postgres
LONG_TERM_SCOPE=user
CHECKPOINTER_BACKEND=postgres
SHORT_TERM_TTL_SECONDS=604800
SHORT_TERM_MAX_MESSAGES=30
SHORT_TERM_SUMMARY_THRESHOLD=20
SAVE_CONVERSATION_TASK=false
MEMORY_TOP_K=6
ENABLE_MILVUS=true
POSTGRES_DSN=postgresql://deepresearch:CHANGE_ME@127.0.0.1:15432/deepresearch
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=mult_agent_memory
KNOWLEDGE_COLLECTION=mult_agent_knowledge
REDIS_URL=redis://127.0.0.1:16379
USER_ID=local_user
TENANT_ID=default_tenant
THREAD_ID=local_cli
APP_ENV=production
HOST=127.0.0.1
PORT=8010
NO_COLOR=1
